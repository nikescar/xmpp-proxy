#!/bin/busybox sh
# nginx-proxy-ctl - Dynamic nginx proxy configuration manager
#
# POSIX sh (not bash): this runs inside a distroless image via busybox ash,
# which has no [[ ]], no =~ regex, and no ((...)) arithmetic.

set -eu

# Validate location path
validate_location_path() {
    local path="$1"

    if [ -z "$path" ]; then
        echo "ERROR: Location path cannot be empty" >&2
        return 1
    fi

    case "$path" in
        /*) ;;
        *)
            echo "ERROR: Location path must start with /" >&2
            return 1
            ;;
    esac

    return 0
}

# Validate upstream URL
validate_upstream_url() {
    local url="$1"

    if [ -z "$url" ]; then
        echo "ERROR: Upstream URL cannot be empty" >&2
        return 1
    fi

    case "$url" in
        http://*|https://*) ;;
        *)
            echo "ERROR: Upstream URL must start with http:// or https://" >&2
            return 1
            ;;
    esac

    return 0
}

# Generate nginx proxy config from template
generate_proxy_config() {
    local location="$1"
    local upstream="$2"
    local options="${3:-}"

    local websocket_headers=""
    local custom_headers=""

    # Add websocket headers if enabled
    case "$options" in
        *websocket*)
            websocket_headers="proxy_set_header Upgrade \$http_upgrade;
    proxy_set_header Connection \"upgrade\";"
            ;;
    esac

    # Set default timeout if not provided
    local timeout="${PROXY_TIMEOUT:-60s}"

    # Generate config from template
    export LOCATION_PATH="$location"
    export UPSTREAM_URL="$upstream"
    export WEBSOCKET_HEADERS="$websocket_headers"
    export CUSTOM_HEADERS="$custom_headers"
    export PROXY_TIMEOUT="$timeout"

    # Restrict substitution to just these placeholders - the template also
    # contains literal nginx runtime variables ($host, $remote_addr, etc.)
    # that must NOT be touched, or an unrestricted envsubst wipes them out
    envsubst '${LOCATION_PATH} ${UPSTREAM_URL} ${WEBSOCKET_HEADERS} ${CUSTOM_HEADERS} ${PROXY_TIMEOUT}' < "$TEMPLATE_FILE"
}

# Configuration
NGINX_CONF_DIR="${NGINX_CONF_DIR:-/etc/nginx/conf.d}"
TEMPLATE_FILE="${TEMPLATE_FILE:-/etc/templates/location-proxy.conf.template}"
NGINX_BIN="${NGINX_BIN:-/usr/sbin/nginx}"

# Add a new proxy location
add_proxy() {
    local location="$1"
    local upstream="$2"
    local options="${3:-}"

    # Validate inputs
    validate_location_path "$location" || return 1
    validate_upstream_url "$upstream" || return 1

    # Check for duplicate location
    local hash=$(echo -n "$location" | md5sum | awk '{print $1}')
    local config_file="$NGINX_CONF_DIR/proxy-$hash.conf"

    if [ -f "$config_file" ]; then
        echo "ERROR: Proxy for location $location already exists" >&2
        return 1
    fi

    # Generate config to temp file
    local temp_file=$(mktemp)
    generate_proxy_config "$location" "$upstream" "$options" > "$temp_file"

    # Test nginx configuration
    if ! $NGINX_BIN -t 2>&1 | grep -q "successful"; then
        rm -f "$temp_file"
        echo "ERROR: nginx configuration test failed" >&2
        return 1
    fi

    # Move to final location
    mv "$temp_file" "$config_file"

    # Reload nginx
    $NGINX_BIN -s reload

    echo "Proxy added: $location -> $upstream"
    return 0
}

# Remove a proxy location
remove_proxy() {
    local location="$1"

    # Find config file by location hash
    local hash=$(echo -n "$location" | md5sum | awk '{print $1}')
    local config_file="$NGINX_CONF_DIR/proxy-$hash.conf"

    if [ ! -f "$config_file" ]; then
        echo "ERROR: Proxy for location $location not found" >&2
        return 1
    fi

    # Delete config file
    rm -f "$config_file"

    # Reload nginx
    $NGINX_BIN -s reload

    echo "Proxy removed: $location"
    return 0
}

# List all configured proxies
list_proxies() {
    local count=0

    for config_file in "$NGINX_CONF_DIR"/proxy-*.conf; do
        if [ -f "$config_file" ]; then
            # Extract location and upstream from config
            local location=$(awk '/location/{print $2; exit}' "$config_file")
            local upstream=$(awk '/proxy_pass/{sub(";", "", $2); print $2; exit}' "$config_file")

            echo "$location -> $upstream"
            count=$((count + 1))
        fi
    done

    if [ $count -eq 0 ]; then
        echo "No proxies configured"
    fi

    return 0
}

# Show usage information
usage() {
    cat <<EOF
Usage: nginx-proxy-ctl <command> [options]

Commands:
  add <location> <upstream> [--websocket] [--timeout <seconds>]
      Add a new proxy location

  remove <location>
      Remove a proxy location

  list
      List all configured proxies

  validate
      Validate nginx configuration

Examples:
  nginx-proxy-ctl add /api/ http://localhost:8000/
  nginx-proxy-ctl add /ws/ http://localhost:8080/ --websocket
  nginx-proxy-ctl remove /api/
  nginx-proxy-ctl list

EOF
}

# Validate nginx configuration
validate_nginx() {
    if $NGINX_BIN -t 2>&1 | grep -q "successful"; then
        echo "✓ nginx configuration is valid"
        return 0
    else
        echo "✗ nginx configuration test failed" >&2
        $NGINX_BIN -t 2>&1 >&2
        return 1
    fi
}

# Main command dispatch
main() {
    local command="${1:-}"

    if [ -z "$command" ]; then
        usage
        exit 1
    fi

    case "$command" in
        add)
            shift
            local location="${1:-}"
            local upstream="${2:-}"
            shift 2 || true

            local options=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --websocket)
                        options="$options websocket"
                        shift
                        ;;
                    --timeout)
                        export PROXY_TIMEOUT="$2"
                        shift 2
                        ;;
                    *)
                        echo "ERROR: Unknown option: $1" >&2
                        usage
                        exit 1
                        ;;
                esac
            done

            add_proxy "$location" "$upstream" "$options"
            ;;

        remove)
            shift
            local location="${1:-}"
            remove_proxy "$location"
            ;;

        list)
            list_proxies
            ;;

        validate)
            validate_nginx
            ;;

        help|--help|-h)
            usage
            exit 0
            ;;

        *)
            echo "ERROR: Unknown command: $command" >&2
            usage
            exit 1
            ;;
    esac
}

# Only run main if executed directly (not sourced for tests). Tests source
# this file under bash with NGINX_PROXY_CTL_SOURCED set, so this check avoids
# relying on bash-only BASH_SOURCE, which busybox ash does not have.
if [ -z "${NGINX_PROXY_CTL_SOURCED:-}" ]; then
    main "$@"
fi
