# Required Configuration
XMPP_DOMAIN=chat.example.com
ACME_EMAIL=admin@example.com

# Optional Configuration
XMPP_ADMIN=admin@chat.example.com
PROSODY_LOGLEVEL=info
ENABLE_WEB_ADMIN=false
FAIL2BAN_MAX_RETRY=5
FAIL2BAN_BAN_TIME=1h
FAIL2BAN_FIND_TIME=10m

# Binary Versions (use 'latest' or specific tag)
# Only used when building from source via docker-compose.dev.yaml.
XMPP_PROXY_VERSION=latest
FAIL2BAN_RS_VERSION=latest
HORUST_VERSION=0.1.13

# ghcr.io/nikescar/xmpp-proxy-stack image tag (docker-compose.yaml only).
# 'latest' tracks the most recent v* release; pin to a specific tag (e.g.
# v1.0.0) to stay on a known-good version.
XMPP_PROXY_STACK_TAG=latest
